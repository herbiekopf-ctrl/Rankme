# Server-side only. Never rename this to NEXT_PUBLIC_CFBD_API_KEY.
CFBD_API_KEY=

# Optional base URL override for testing a compatible adapter.
CFBD_API_BASE_URL=https://api.collegefootballdata.com

# One shared refresh per week (4 upstream endpoint requests per refresh job).
CFBD_REFRESH_SECONDS=604800

# Optional writable/persistent directory for the compiled snapshot.
# CFBD_SNAPSHOT_DIR=/var/lib/ranked
