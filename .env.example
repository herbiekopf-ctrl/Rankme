# Server-side only. Never rename this to NEXT_PUBLIC_CFBD_API_KEY.
CFBD_API_KEY=

# Optional base URL override for testing a compatible adapter.
CFBD_API_BASE_URL=https://api.collegefootballdata.com

# One shared refresh per week (26 batched upstream datasets per refresh job).
CFBD_REFRESH_SECONDS=604800

# Optional writable/persistent directory for the compiled snapshot.
# CFBD_SNAPSHOT_DIR=/var/lib/ranked

# Supabase project settings. The publishable key is safe for browser use;
# the secret key is server-only and bypasses RLS for ingestion/admin jobs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Long random value used only by the scheduled protected refresh endpoint.
RANKED_INGEST_TOKEN=

# Legacy server key name is also supported during Supabase key migration.
# SUPABASE_SERVICE_ROLE_KEY=
